<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AuthOnWatch" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>

        <item name="colorPrimary">#3134a3</item>
        <item name="colorPrimaryVariant">#3334a3</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AuthOnWatch.Splash" parent="Theme.AuthOnWatch">
        <item name="android:windowBackground">@drawable/icon_splash</item>
    </style>
</resources>